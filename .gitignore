/target
/.worktrees

# Personal/local devkit configs. The config that drives the engine is
# machine- and person-specific (paths, app catalog, Slack/GitHub handles,
# local secrets) and must never be distributed. The config shape is
# documented on the config types; `devkit schema` prints it.
/configs/*.toml
devkit.local.toml
/AGENTS.local.md
/CLAUDE.local.md
/.agents/**/__pycache__/
/.agents/**/.venv/

# The sources harnessup copies into cloud sessions are checked in.
!/.agents/harnessup/*.local.*

# Subagent-driven-development progress ledger (local scratch)
/.superpowers/
