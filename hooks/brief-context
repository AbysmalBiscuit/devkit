#!/usr/bin/env bash
# Emit the devkit project brief through the harness's additional-context field,
# for the Codex and Cursor hooks. `hooks/brief` is the Claude Code twin: there
# plain stdout is injected, so it needs no envelope.
#
# Silent and exit 0 when devkit is not installed or the checkout produces no
# brief, so a session in an unrelated repository starts unchanged. Hook payload
# arrives on stdin and is inherited by `devkit brief`, which reads session_id
# from it to track what a session has already been told.

set -euo pipefail
source "$(dirname "$0")/hook-json"

command -v devkit >/dev/null 2>&1 || exit 0
brief=$(devkit brief "$@" 2>/dev/null || true)
[ -n "$brief" ] || exit 0

emit_additional_context "$brief"
