{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "./hooks/run-hook.cmd bootstrap-binaries"
      },
      {
        "type": "command",
        "command": "devkit brief --additional-context"
      }
    ],
    "beforeShellExecution": [
      {
        "type": "command",
        "command": "devkit harness shell",
        "timeout": 10
      }
    ]
  }
}
