{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" announce-skill",
            "async": false
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" brief-context --pins-only",
            "async": false,
            "timeout": 10,
            "statusMessage": "Re-injecting devkit library versions"
          }
        ]
      }
    ]
  }
}
