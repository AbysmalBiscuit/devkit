{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries",
            "commandWindows": "& \"${PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries",
            "async": false
          },
          {
            "type": "command",
            "command": "devkit brief --additional-context",
            "async": false,
            "timeout": 10,
            "statusMessage": "Loading the devkit project brief"
          },
          {
            "type": "command",
            "command": "devkit hook session-start --harness codex",
            "async": false
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "devkit brief --additional-context --pins-only",
            "async": false,
            "timeout": 10,
            "statusMessage": "Re-injecting devkit library versions"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook session-end --harness codex",
            "async": false,
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook pre-tool-use --harness codex",
            "async": false,
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook post-tool-use --harness codex",
            "async": false
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook subagent-start --harness codex",
            "async": false
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook subagent-stop --harness codex",
            "async": false
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook permission-request --harness codex",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook stop --harness codex",
            "async": false
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook stop --harness codex",
            "async": false
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook pre-compact --harness codex",
            "async": false
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook post-compact --harness codex",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook user-prompt-submit --harness codex",
            "async": false
          }
        ]
      }
    ]
  }
}
