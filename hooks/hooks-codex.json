{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries",
            "commandWindows": "& \"${PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries",
            "async": false
          },
          {
            "type": "command",
            "command": "devkit brief --additional-context",
            "async": false,
            "timeout": 10,
            "statusMessage": "Loading the devkit project brief"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "devkit brief --additional-context --pins-only",
            "async": false,
            "timeout": 10,
            "statusMessage": "Re-injecting devkit library versions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          { "type": "command", "command": "lockm hook pretooluse" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "devkit harness shell",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "lockm hook subagent-stop" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "lockm hook session-end" }
        ]
      }
    ]
  }
}
