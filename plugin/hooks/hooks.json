{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" bootstrap-binaries"
          },
          {
            "type": "command",
            "command": "devkit brief"
          },
          {
            "type": "command",
            "command": "devkit rules context"
          },
          {
            "type": "command",
            "command": "devkit hook session-start --harness claude-code"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook session-end --harness claude-code",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook pre-tool-use --harness claude-code",
            "timeout": 4
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook post-tool-use --harness claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook post-tool-use-failure --harness claude-code"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook subagent-start --harness claude-code"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook subagent-stop --harness claude-code"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook permission-request --harness claude-code"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook permission-denied --harness claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook stop --harness claude-code"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook stop-failure --harness claude-code"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook pre-compact --harness claude-code"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit brief --pins-only",
            "timeout": 3,
            "statusMessage": "Re-injecting devkit library versions"
          },
          {
            "type": "command",
            "command": "devkit hook post-compact --harness claude-code"
          },
          {
            "type": "command",
            "command": "devkit rules context",
            "timeout": 3,
            "statusMessage": "Re-injecting repository rules"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit brief --if-changed",
            "timeout": 3,
            "statusMessage": "Refreshing devkit project brief"
          },
          {
            "type": "command",
            "command": "devkit hook cwd-changed --harness claude-code"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook worktree-create --harness claude-code"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook worktree-remove --harness claude-code"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook user-prompt-submit --harness claude-code"
          }
        ]
      }
    ]
  }
}
