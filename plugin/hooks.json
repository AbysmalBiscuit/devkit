{
  "devkit": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook pre-tool-use --harness antigravity",
            "timeout": 4
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "devkit hook post-tool-use --harness antigravity"
          }
        ]
      }
    ]
  }
}
